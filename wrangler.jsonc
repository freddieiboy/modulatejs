{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modulatejs",
  "main": "src/worker/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/library", "/library/", "/mcp", "/mcp/"]
  },
  // coral.fm is the app, modulatejs.com is the library; the worker routes by host
  // Zone routes, not custom domains: both zones already have proxied DNS records for the apex and www.
  "routes": [
    { "pattern": "coral.fm/*", "zone_name": "coral.fm" },
    { "pattern": "www.coral.fm/*", "zone_name": "coral.fm" },
    { "pattern": "modulatejs.com/*", "zone_name": "modulatejs.com" },
    { "pattern": "www.modulatejs.com/*", "zone_name": "modulatejs.com" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
