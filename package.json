{
  "name": "modulatejs",
  "version": "0.17.1",
  "description": "ModulateJS is a lightweight prototyping library: a small vocabulary for mobile-app feel. Fifteen lines, a link, and it's on your phone. Built on Motion.",
  "keywords": [
    "prototype",
    "animation",
    "motion",
    "spring",
    "gesture",
    "mobile",
    "llm",
    "live-coding"
  ],
  "homepage": "https://modulatejs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freddieiboy/modulatejs.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "./dist/modulate.mjs",
  "module": "./dist/modulate.mjs",
  "types": "./dist/modulate.d.ts",
  "unpkg": "./dist/modulate.js",
  "jsdelivr": "./dist/modulate.js",
  "exports": {
    ".": {
      "types": "./dist/modulate.d.ts",
      "import": "./dist/modulate.mjs",
      "default": "./dist/modulate.js"
    },
    "./link": "./dist/link.mjs",
    "./modulate.js": "./dist/modulate.js",
    "./SPEC.md": "./SPEC.md"
  },
  "bin": {
    "modulatejs": "./bin/modulate.mjs",
    "modulate": "./bin/modulate.mjs"
  },
  "files": [
    "dist",
    "bin",
    "SPEC.md",
    "prototypes",
    "LICENSE.md",
    "LICENSE-AGPL-3.0.txt",
    "THIRD_PARTY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node scripts/build.mjs && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "acorn": "^8.18.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "lz-string": "^1.5.0",
    "marked": "^18.0.13",
    "motion": "^13.4.0",
    "playwright-core": "^1.63.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.133.0"
  }
}
